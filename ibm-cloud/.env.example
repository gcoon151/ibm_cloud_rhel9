# IBM Cloud VSI-Based PodVM Builder Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# IBM Cloud Configuration
# ============================================================================

# IBM Cloud Region (e.g., us-south, us-east, eu-de, jp-tok)
IBM_CLOUD_REGION="us-south"

# IBM Cloud Zone within the region (e.g., us-south-1, us-south-2)
IBM_CLOUD_ZONE="us-south-1"

# IBM Cloud Resource Group
IBM_CLOUD_RESOURCE_GROUP="default"

# VPC Name (must exist before running builder)
IBM_CLOUD_VPC_NAME="podvm-builder-vpc"

# Subnet Name (must exist, should be private with no public gateway)
IBM_CLOUD_SUBNET_NAME="podvm-builder-subnet"

# VSI Profile (determines CPU/RAM)
# Options: bx2-2x8 (2 vCPU, 8GB), bx2-4x16 (4 vCPU, 16GB), etc.
# See: https://cloud.ibm.com/docs/vpc?topic=vpc-profiles
IBM_CLOUD_VSI_PROFILE="bx2-2x8"

# VSI Base Image (RHEL 9 minimal recommended)
# Find images: ibmcloud is images --visibility public | grep rhel-9
IBM_CLOUD_VSI_IMAGE="ibm-redhat-9-3-minimal-amd64-1"

# ============================================================================
# Cloud Object Storage (COS) Configuration
# ============================================================================

# COS Bucket Name (must exist)
COS_BUCKET_NAME="podvm-images"

# Base Image Name in COS (the pre-built QCOW2 to start from)
COS_BASE_IMAGE_NAME="rhel9-base.qcow2"

# COS Endpoint (regional endpoint for your bucket)
# Format: s3.<region>.cloud-object-storage.appdomain.cloud
COS_ENDPOINT="s3.us-south.cloud-object-storage.appdomain.cloud"

# COS Instance ID (find with: ibmcloud resource service-instances --service-name cloud-object-storage)
COS_INSTANCE_ID=""

# ============================================================================
# Build Configuration
# ============================================================================

# Output Image Prefix (will be suffixed with -YYYYMMDD##.qcow2)
OUTPUT_IMAGE_PREFIX="podvm-rhel9"

# Work Directory (temporary files during build)
WORK_DIR="/tmp/podvm-builder"

# Log File Location
LOG_FILE="${WORK_DIR}/build.log"

# ============================================================================
# Optional: Red Hat Subscription (if needed for packages)
# ============================================================================

# Red Hat Activation Key (for subscription-manager)
# ACTIVATION_KEY=""

# Red Hat Organization ID
# ORG_ID=""

# ============================================================================
# Optional: Secure Boot Signing
# ============================================================================

# Path to secure boot private key (for signing UKI addons)
# SB_PRIVATE_KEY=""

# Path to secure boot certificate
# SB_CERTIFICATE=""

# ============================================================================
# Optional: Custom Scripts
# ============================================================================

# Directory containing custom transformation scripts
# CUSTOM_SCRIPTS_DIR="${PWD}/custom-scripts"

# ============================================================================
# Advanced Configuration
# ============================================================================

# Maximum wait time for VSI to start (seconds)
# VSI_START_TIMEOUT=300

# Maximum wait time for build to complete (seconds)
# BUILD_TIMEOUT=3600

# Cleanup on failure (true/false)
# CLEANUP_ON_FAILURE=true

# Keep VSI after build for debugging (true/false)
# KEEP_VSI_FOR_DEBUG=false