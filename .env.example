# Red Hat Subscription Credentials
# Required for building PodVM images
ORG_ID=your_org_id_here
ACTIVATION_KEY=your_activation_key_here

# Container Registry Credentials
# Required for pushing payload binaries
QUAY_USERNAME=your_quay_username
QUAY_PASSWORD=your_quay_password_or_token

# IBM Cloud Credentials
# Required for creating VSI images
IBM_CLOUD_COS_API_KEY=your_ibm_cloud_api_key
IBM_CLOUD_COS_RESOURCE_INSTANCE_ID=your_cos_resource_crn

# Build Configuration
# Optional: Override defaults
PODVM_TAG=candidate
SSHD_SERVICE=true
APPLY_VERITY=false

# Remote Build Host
# Optional: Override default remote host
REMOTE_HOST=gcoon@192.168.1.196